# ── Python / 工具缓存 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ── 打包产物 ──
dist/
build/

# ── 本地运行数据（禁止提交）──
# data/ 是插件运行时数据目录，含导出的 txt/json、已下载歌曲、登录 session 等
data/
store.db

# ── 密钥与登录态（禁止提交）──
# 网易云 / B站 / QQ音乐 的 cookie、session 会落在这类文件里
*.cookie.json
*.session.json
.env
.env.*
!.env.example

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
# 保留 check --release 必需的 .vscode 脚手架，忽略其余（如 launch.json 等可能含本地路径）
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
.idea/

# ── WorkBuddy 内部目录（非插件逻辑，禁止提交）──
.workbuddy/

# ── 运行时下载 / 生成产物（禁止提交）──
# 下载的音频、UI 上传文件落在 <config_dir>/static/uploads/（见 _uploads_dir()）
static/uploads/
# 音频后缀兜底：任何位置的下载音频都不进仓库
*.mp3
*.m4a
*.wav
*.flac
*.ogg
*.aac
*.ape
*.wma
# 运行时可能生成的 JS / 缓存（当前仓库无受控 .js，可安全忽略）
*.js
